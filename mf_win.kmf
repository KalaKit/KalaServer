#KMF VERSION 1.0

//Manifest file for use with kalamove. Read more at https://github.com/kalakit/kalamove

//
// CORE STUFF
//

//copy readme
origin: readme.md
target: ..@..@_websites@server@_external_shared@KalaServer@readme.md
action: forcecopy

//copy license
origin: LICENSE.md
target: ..@..@_websites@server@_external_shared@KalaServer@LICENSE.md
action: forcecopy

//copy include files
origin: include
target: ..@..@_websites@server@_external_shared@KalaServer@include
action: forcecopy

//copy docs
origin: docs
target: ..@..@_websites@server@_external_shared@KalaServer@docs
action: forcecopy

//
// BINARIES
//

//copy debug dll
origin: build@windows-debug@KalaServer1d.dll
target: ..@..@_websites@server@_external_shared@KalaServer@debug@KalaServer1d.dll
action: forcecopy

//copy debug lib
origin: build@windows-debug@KalaServer1d.lib
target: ..@..@_websites@server@_external_shared@KalaServer@debug@KalaServer1d.lib
action: forcecopy

//copy debug pdb
origin: build@windows-debug@KalaServer1d.pdb
target: ..@..@_websites@server@_external_shared@KalaServer@debug@KalaServer1d.pdb
action: forcecopy

//copy release lib
origin: build@windows-release@KalaServer1.dll
target: ..@..@_websites@server@_external_shared@KalaServer@release@KalaServer1.dll
action: forcecopy

//copy release lib
origin: build@windows-release@KalaServer1.lib
target: ..@..@_websites@server@_external_shared@KalaServer@release@KalaServer1.lib
action: forcecopy

//
// EXTERNAL LIBRARIES
//

//KalaHeaders
origin: _external_shared@KalaHeaders
target: ..@..@_websites@server@_external_shared@KalaHeaders
action: copy

//Cloudflared
origin: _external_shared@Cloudflared
target: ..@..@_websites@server@_external_shared@Cloudflared
action: copy
