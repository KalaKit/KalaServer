action: forcecopy

//copy debug so
origin: build@linux-debug@libKalaServer1d.so
target: ..@jutt@_external_shared@KalaServer@debug@libKalaServer1d.so
action: forcecopy

//copy release dll
origin: build@windows-release@libKalaServer1.dll
