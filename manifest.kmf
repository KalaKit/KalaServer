#KMF VERSION 1.0

//Manifest file for use with kalamove. Read more at https://github.com/kalakit/kalamove

//
// CORE STUFF
//

//copy readme
origin: readme.md
target: ..@jutt@_external_shared@KalaServer@readme.md
action: forcecopy

//copy license
origin: LICENSE.md
target: ..@jutt@_external_shared@KalaServer@LICENSE.md
action: forcecopy

//copy include files
origin: include
target: ..@jutt@_external_shared@KalaServer@include
