#KMF VERSION 1.0

//Manifest file for use with kalamove. Read more at https://github.com/kalakit/kalamove

//
// CORE STUFF
//

//copy readme
origin: README.md
target: ..@external-shared@KalaServer@README.md
action: forcecopy

//copy license
origin: LICENSE.md
target: ..@external-shared@KalaServer@LICENSE.md
action: forcecopy

//copy include files
origin: include
target: ..@external-shared@KalaServer@include
action: forcecopy

//copy docs
origin: docs
target: ..@external-shared@KalaServer@docs
action: forcecopy

//
// BINARIES
//

//copy debug
origin: build@debug-linux@libkalaserverd.a
target: ..@external-shared@KalaServer@debug@libkalaserverd.a
action: forcecopy

//copy release
origin: build@release-linux@libkalaserver.a
target: ..@external-shared@KalaServer@release@libkalaserver.a
action: forcecopy
