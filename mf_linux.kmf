#KMF VERSION 1.0

//Manifest file for use with kalamove. Read more at https://github.com/kalakit/kalamove

//
// CORE STUFF
//

//copy readme
origin: README.md
target: ..@..@_websites@server@_external_shared@KalaServer@README.md
action: forcecopy

//copy license
origin: LICENSE.md
target: ..@..@_websites@server@_external_shared@KalaServer@LICENSE.md
action: forcecopy

//copy include files
origin: include
target: ..@..@_websites@server@_external_shared@KalaServer@include
action: forcecopy

//copy docs
origin: docs
target: ..@..@_websites@server@_external_shared@KalaServer@docs
action: forcecopy

//
// BINARIES
//

//copy debug so
origin: build@debug-linux@libKalaServer1d.so
target: ..@..@_websites@server@_external_shared@KalaServer@debug@libKalaServer1d.so
action: forcecopy

//copy release so
origin: build@release-linux@libKalaServer1.so
target: ..@..@_websites@server@_external_shared@KalaServer@release@libKalaServer1.so
action: forcecopy

//
// EXTERNAL LIBRARIES
//

//KalaHeaders
origin: _external_shared@KalaHeaders
target: ..@..@_websites@server@_external_shared@KalaHeaders
action: copy
